<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindcareDiary"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".paciente.DiarioPacienteActivity"
            android:exported="false" />
        <activity
            android:name=".paciente.InicioPacienteActivity"
            android:exported="false" />
        <activity
            android:name=".profissional.InicioProfissionalctivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".TipoUsuarioActivity"
            android:exported="false" />
        <activity
            android:name=".BemVindoActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MindcareDiary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>